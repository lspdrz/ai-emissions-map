{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lspdrz/ai-emissions-map/docs/serving-locations/serving-locations.v1.schema.json",
  "title": "AI serving locations (ai-emissions-map/serving-locations/v1)",
  "description": "Where each model an organization serves actually runs. Suggested location: /.well-known/ai-serving-locations.json on the organization's own domain. Facilities are identified by name and city, never street address.",
  "type": "object",
  "required": [
    "schema",
    "organization",
    "contact",
    "published",
    "services"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "ai-emissions-map/serving-locations/v1"
    },
    "organization": {
      "type": "string",
      "minLength": 1
    },
    "contact": {
      "type": "string",
      "minLength": 1
    },
    "published": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "service",
          "endpoint",
          "models"
        ],
        "additionalProperties": false,
        "properties": {
          "service": {
            "type": "string",
            "minLength": 1
          },
          "endpoint": {
            "type": "string",
            "minLength": 1
          },
          "models": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "model",
                "routing"
              ],
              "additionalProperties": false,
              "properties": {
                "model": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The exact model version actually served (a Hugging Face repository id where one exists)"
                },
                "served_as": {
                  "type": "string",
                  "minLength": 1
                },
                "routing": {
                  "type": "array",
                  "minItems": 1,
                  "description": "One entry per way a customer can have this model served: the default, and each region or zone a customer can choose instead. Each entry becomes one route on the map. At most one entry is the default, and it comes first.",
                  "prefixItems": [
                    {
                      "$comment": "routing[0]: may be the default.",
                      "$ref": "#/$defs/route"
                    }
                  ],
                  "items": {
                    "$comment": "routing[1] onwards: may not be the default.",
                    "allOf": [
                      {
                        "$ref": "#/$defs/route"
                      },
                      {
                        "properties": {
                          "default": {
                            "const": false
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "route": {
      "type": "object",
      "required": [
        "name",
        "locations"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "The provider's name for this option, such as global, eu or europe-west3"
        },
        "default": {
          "type": "boolean",
          "description": "true for the routing requests get when the customer chooses nothing; only the first entry may be the default"
        },
        "endpoint": {
          "type": "string",
          "minLength": 1,
          "description": "The endpoint for this option, when it differs from the service's"
        },
        "locations": {
          "type": "array",
          "minItems": 1,
          "description": "Every location requests on this route may run in, failover and overflow included; each is a candidate on the route",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "facility": {
                "type": "string",
                "minLength": 1,
                "description": "The facility's name; with operator and city this is level A"
              },
              "operator": {
                "type": "string",
                "minLength": 1,
                "description": "Who operates the building (may differ from the provider)"
              },
              "ownership": {
                "enum": [
                  "owned",
                  "colocation",
                  "hpc_center",
                  "gpu_cloud"
                ]
              },
              "region": {
                "type": "string",
                "minLength": 1,
                "description": "A cloud or provider region, when facilities are not named; it resolves to its grid zones"
              },
              "city": {
                "type": "string",
                "minLength": 1
              },
              "country": {
                "type": "string",
                "pattern": "^[A-Z]{2}$",
                "description": "ISO 3166-1 alpha-2"
              },
              "grid_zone": {
                "type": "string",
                "minLength": 1,
                "description": "Electricity Maps zone code (recommended)"
              },
              "share_of_traffic": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Intended share of this route's traffic. Shown, not used to average"
              }
            }
          }
        }
      }
    }
  }
}
