{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Model",
  "type": "object",
  "required": [
    "name",
    "architecture",
    "active_b",
    "total_b",
    "evidence"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "$ref": "#/$defs/slug",
      "description": "The model id routes use in `model:`; must equal the filename stem. Takes precedence over an EcoLogits catalogue entry with the same id."
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "$ref": "#/$defs/aliases"
    },
    "architecture": {
      "enum": [
        "dense",
        "moe"
      ]
    },
    "active_b": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "object",
          "required": [
            "min",
            "max"
          ],
          "additionalProperties": false,
          "properties": {
            "min": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "max": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      ],
      "description": "Billions of parameters: a number, or {min, max} when only a range is published"
    },
    "total_b": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "object",
          "required": [
            "min",
            "max"
          ],
          "additionalProperties": false,
          "properties": {
            "min": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "max": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      ],
      "description": "Billions of parameters: a number, or {min, max} when only a range is published"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "minItems": 1
    },
    "comments": {
      "type": "string"
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO 8601, quoted in YAML"
    },
    "aliases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/slug"
      },
      "uniqueItems": true,
      "description": "Retired slugs of this record. A slug leaves the corpus only by appearing here."
    },
    "evidence": {
      "type": "object",
      "required": [
        "url",
        "shows",
        "accessed",
        "http_status",
        "content_sha256",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "shows": {
          "type": "string",
          "minLength": 1,
          "description": "What the source actually says, quoted from the page that was read"
        },
        "accessed": {
          "$ref": "#/$defs/date"
        },
        "http_status": {
          "type": "integer"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "kind": {
          "enum": [
            "primary",
            "corroborating"
          ]
        },
        "capture": {
          "enum": [
            "auto",
            "manual"
          ]
        },
        "anomaly": {
          "type": "string"
        }
      }
    }
  }
}
