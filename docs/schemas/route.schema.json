{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Route",
  "type": "object",
  "required": [
    "name",
    "model"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "$ref": "#/$defs/slug",
      "description": "The slug, '<org>-<model>'; must equal the filename stem"
    },
    "aliases": {
      "$ref": "#/$defs/aliases"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "served_as": {
      "type": "string"
    },
    "served_model_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "pinned": {
      "type": "boolean",
      "description": "A location the customer must choose (a pinnable region or jurisdiction), not where the service runs by default. Rated and shown, but left out of the organization's average."
    },
    "location": {
      "type": "object",
      "required": [
        "confidence",
        "candidates",
        "last_verified",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "enum": [
            "unknown",
            "country_set",
            "country",
            "region",
            "facility"
          ]
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(facility:[a-z0-9-]+|cloud:[a-z0-9-]+:[A-Za-z0-9-]+|zone:[A-Za-z0-9_-]+)$"
          }
        },
        "last_verified": {
          "$ref": "#/$defs/date",
          "description": "When everything in this location claim was last confirmed against its evidence"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "upstreams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "route",
          "weight"
        ],
        "additionalProperties": false,
        "properties": {
          "route": {
            "$ref": "#/$defs/slug"
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "upstream_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "comments": {
      "type": "string"
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO 8601, quoted in YAML"
    },
    "aliases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/slug"
      },
      "uniqueItems": true,
      "description": "Retired slugs of this record. A slug leaves the corpus only by appearing here."
    },
    "evidence": {
      "type": "object",
      "required": [
        "url",
        "shows",
        "accessed",
        "content_sha256",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "shows": {
          "type": "string",
          "minLength": 1,
          "description": "What the source actually says, quoted from the page that was read"
        },
        "accessed": {
          "$ref": "#/$defs/date"
        },
        "http_status": {
          "type": "integer"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "kind": {
          "enum": [
            "primary",
            "corroborating"
          ]
        },
        "capture": {
          "enum": [
            "auto",
            "browser",
            "manual"
          ]
        },
        "anomaly": {
          "type": "string"
        }
      },
      "if": {
        "properties": {
          "capture": {
            "const": "manual"
          }
        },
        "required": [
          "capture"
        ]
      },
      "else": {
        "required": [
          "http_status"
        ]
      }
    }
  }
}
